{
  "name": "digitalis-receptkonyv",
  "version": "1.0.0",
  "description": "Digitális receptkönyv – Informatika projekt 1 (Dunaújvárosi Egyetem)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "app": "node scripts/launch.mjs",
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "tsx server/src/db/reset.ts",
    "perf": "node scripts/measure-performance.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
